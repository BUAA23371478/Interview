# ── 应用 ──────────────────────────────────────────────
# 平台自动注入，不要硬编码
# PORT=8002
# BASE_URL=/app/interview-agent/
# 本地开发兜底用户（无 X-Maoo-* 请求头时）
# DEV_USER_ID=1
# DEV_USERNAME=dev_user
# DEV_ROLE=developer

# ── LLM（DeepSeek，OpenAI 兼容）──────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Embedding（SiliconFlow bge-m3，OpenAI 兼容）──────
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# ── 数据库（平台注入 MYSQL_* 时自动使用 MySQL，否则 SQLite）──
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# ── Redis（可选，未配置时用内存）──────────────────────
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── 知识库审核 ────────────────────────────────────────
# AI 预审通过推荐阈值
KB_AI_APPROVE_THRESHOLD=60
# 每人每日上传上限
KB_DAILY_UPLOAD_LIMIT=5
KB_DAILY_CHAR_LIMIT=200000
# 管理员角色（命中其一即可）
ADMIN_ROLES=admin,developer

# ── RAG ───────────────────────────────────────────────
RAG_TOP_K=5
RAG_USE_RERANK=false

# ── 面试/练习 ─────────────────────────────────────────
DEFAULT_INTERVIEW_ROUNDS=10
MAX_INTERVIEW_ROUNDS=20
MAX_FOLLOWUPS_PER_ROUND=2
